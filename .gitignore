# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/

# Production build
build/
dist/

# Environment variables — never commit secrets
.env
.env.*
!.env.example

# Database
prisma/migrations/.env

# Testing
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db
*.pem

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Editor
.vscode/
.idea/
*.swp
*.swo

# Project internals
development-plan.md
