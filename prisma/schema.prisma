// =============================================================================// connect-dutse Database Schema// =============================================================================generator client {  provider = "prisma-client-js"}datasource db {  provider = "postgresql"  url      = env("DATABASE_URL")}// =============================================================================// Enums// =============================================================================enum UserRole {  CUSTOMER  PRODUCT_SELLER  SERVICE_PROVIDER  ADMIN}enum CategoryType {  PRODUCT  SERVICE}enum ListingStatus {  PENDING  ACTIVE  REJECTED  SUSPENDED}enum ProductCondition {  NEW  USED}enum MediaType {  IMAGE  VIDEO}enum ReportStatus {  OPEN  REVIEWED  RESOLVED}// =============================================================================// Users// =============================================================================model User {  id             String    @id @default(cuid())  email          String    @unique  passwordHash   String    @map("password_hash")  name           String  avatar         String?  role           UserRole  @default(CUSTOMER)  emailVerified  Boolean   @default(false) @map("email_verified")  phoneNumber    String?   @map("phone_number")  whatsappNumber String?   @map("whatsapp_number")  location       String?  createdAt      DateTime  @default(now()) @map("created_at")  updatedAt      DateTime  @updatedAt @map("updated_at")  // Relations  listings Listing[]  reviews  Review[]  reports  Report[]  sessions Session[]  @@map("users")}// =============================================================================// Sessions (Better Auth)// =============================================================================model Session {  id        String   @id @default(cuid())  userId    String   @map("user_id")  token     String   @unique  expiresAt DateTime @map("expires_at")  createdAt DateTime @default(now()) @map("created_at")  updatedAt DateTime @updatedAt @map("updated_at")  user User @relation(fields: [userId], references: [id], onDelete: Cascade)  @@map("sessions")}// =============================================================================// Email Verification & Password Reset Tokens// =============================================================================model VerificationToken {  id         String   @id @default(cuid())  identifier String  token      String   @unique  expiresAt  DateTime @map("expires_at")  createdAt  DateTime @default(now()) @map("created_at")  @@unique([identifier, token])  @@map("verification_tokens")}// =============================================================================// Categories// =============================================================================model Category {  id   String       @id @default(cuid())  name String  slug String       @unique  type CategoryType  icon String?  listings Listing[]  @@map("categories")}// =============================================================================// Listings// =============================================================================model Listing {  id          String        @id @default(cuid())  title       String  description String  categoryId  String        @map("category_id")  ownerId     String        @map("owner_id")  status      ListingStatus @default(PENDING)  location    String  latitude    Float?  longitude   Float?  viewsCount  Int           @default(0) @map("views_count")  createdAt   DateTime      @default(now()) @map("created_at")  updatedAt   DateTime      @updatedAt @map("updated_at")  // Relations  category Category  @relation(fields: [categoryId], references: [id])  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)  product  Product?  service  Service?  media    Media[]  reviews  Review[]  reports  Report[]  @@index([categoryId])  @@index([ownerId])  @@index([status])  @@index([createdAt(sort: Desc)])  @@map("listings")}// =============================================================================// Products (extends Listing)// =============================================================================model Product {  listingId  String           @id @map("listing_id")  condition  ProductCondition  price      Decimal          @db.Decimal(12, 2)  negotiable Boolean          @default(false)  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)  @@map("products")}// =============================================================================// Services (extends Listing)// =============================================================================model Service {  listingId       String   @id @map("listing_id")  experienceYears Int?     @map("experience_years")  startingPrice   Decimal? @map("starting_price") @db.Decimal(12, 2)  availability    String?  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)  @@map("services")}// =============================================================================// Media// =============================================================================model Media {  id        String    @id @default(cuid())  listingId String    @map("listing_id")  url       String  type      MediaType  size      Int  order     Int       @default(0)  createdAt DateTime  @default(now()) @map("created_at")  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)  @@index([listingId])  @@map("media")}// =============================================================================// Reviews// =============================================================================model Review {  id         String   @id @default(cuid())  listingId  String   @map("listing_id")  reviewerId String   @map("reviewer_id")  rating     Int  comment    String?  createdAt  DateTime @default(now()) @map("created_at")  updatedAt  DateTime @updatedAt @map("updated_at")  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)  // A user can only review a listing once  @@unique([listingId, reviewerId])  @@index([listingId])  @@map("reviews")}// =============================================================================// Reports// =============================================================================model Report {  id        String       @id @default(cuid())  listingId String       @map("listing_id")  userId    String       @map("user_id")  reason    String  status    ReportStatus @default(OPEN)  createdAt DateTime     @default(now()) @map("created_at")  updatedAt DateTime     @updatedAt @map("updated_at")  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)  @@index([status])  @@index([listingId])  @@map("reports")}