# =============================================================================# connect-dutse Environment Configuration# Copy this file to .env.local and fill in your values.# NEVER commit .env.local to version control.# =============================================================================# -----------------------------------------------------------------------------# App# -----------------------------------------------------------------------------NEXT_PUBLIC_APP_URL=http://localhost:3000NEXT_PUBLIC_APP_NAME="Connect Dutse"# -----------------------------------------------------------------------------# Database (PostgreSQL via Neon or Supabase)# -----------------------------------------------------------------------------DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/connect_dutse?sslmode=require"# -----------------------------------------------------------------------------# Authentication (Better Auth)# -----------------------------------------------------------------------------BETTER_AUTH_SECRET="your-secret-key-min-32-chars-change-this"BETTER_AUTH_URL=http://localhost:3000# -----------------------------------------------------------------------------# Email (for verification and password reset)# -----------------------------------------------------------------------------EMAIL_FROM="noreply@connect-dutse.com"EMAIL_SERVER_HOST="smtp.example.com"EMAIL_SERVER_PORT=587EMAIL_SERVER_USER="your-email-user"EMAIL_SERVER_PASSWORD="your-email-password"# -----------------------------------------------------------------------------# Storage (Cloudflare R2)# -----------------------------------------------------------------------------R2_ACCOUNT_ID="your-cloudflare-account-id"R2_ACCESS_KEY_ID="your-r2-access-key-id"R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"R2_BUCKET_NAME="connect-dutse-media"R2_PUBLIC_URL="https://your-r2-public-domain.com"# -----------------------------------------------------------------------------# Rate Limiting (Upstash Redis - optional for MVP)# -----------------------------------------------------------------------------# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"